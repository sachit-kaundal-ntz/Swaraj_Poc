    "notes": [
      {
        "type": "general",
        "text": "(A) ALL DIMENSIONS ARE IN MM UNLESS STATED OTHERWISE."
      },
      {
        "type": "general",
        "text": "(B) CODE PRACTICE ABBREVIATIONS ETC TO IS:696."
      },
      {
        "type": "general",
        "text": "(C) WORK TO MEDIUM TOLERANCES OF IS:2102 TABLE-1 PAGE 3 FOR DIMENSIONS OF MACHINED SURFACES WHICH LIMITS HAVE NOT BEEN SPECIFIED."
      },
      {
        "type": "forging_details",
        "text": "1. NORMALISE TO 155-185 BHN."
      },
      {
        "type": "forging_details",
        "text": "2. GRAIN SIZE 5 TO 8 ASTM."
      },
      {
        "type": "forging_details",
        "text": "3. MICROSTRUCTURE ON REPRESENTATIVE SAMPLE MUST SHOW UNIFORM GRAINED LAMELLAR PEARLITE & FERRITE FREE FROM WIDMANSTATTEN INTERMEDIATE & BANDED STRUCTURE."
      },
      {
        "type": "forging_details",
        "text": "4. FORGING TO HAVE BAINITE UP TO 5%."
      },
      {
        "type": "heat_treatment",
        "text": "CASE CARBURIZED TO A DEPTH OF 0.9-1.2 & HARDEN TO 58-62 HRC."
      },
      {
        "type": "heat_treatment",
        "text": "CORE HARDNESS 32-42 HRC."
      },
      {
        "type": "surface_treatment",
        "text": "SHOT BLAST TO DESCALE SHOT SIZE ≤ 1MM."
      },
      {
        "type": "general_sharp_corners",
        "text": "ALL SHARP CORNERS INCLUDING GEAR TEETH & SPLINE EDGES TO BE FREE FROM BURRS."
      },
      {
        "type": "specific_note",
        "text": "1. NEGATIVE CROWNING IS NOT ALLOWED ON GEAR TEETH PROFILE."
      },
      {
        "type": "specific_note",
        "text": "2. QUALITY REQUIREMENT AND ACCEPTABILITY NORMS TO CONFIRM SWARAJ ENGINEERING STANDARD SES-1007."
      },
      {
        "type": "specific_note",
        "text": "3. EAP MAY BE CONSIDERED AS 135 FOR INSPECTION PURPOSE ONLY."
